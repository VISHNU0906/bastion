{#-
  Prometheus recording + alerting rules for Bastion security SLOs.

  Two generation paths, chosen per SLO by sli_type:

  * Burn-rate SLOs (ratio / freshness / latency_ratio):
      - one recording rule per window -> securityslo:<slug>:error_ratio_rate<window>
      - the four multi-window multi-burn-rate alerts (Google SRE Workbook).
  * Threshold SLOs:
      - a single comparison alert; there is no error budget when the target is
        a hard invariant (e.g. 0 critical CVEs older than 7 days).

  PromQL contains {, }, /, " -- every expr is emitted as a double-quoted YAML
  scalar with internal quotes escaped, so the file always round-trips through
  yaml.safe_load. trim_blocks + lstrip_blocks keep block tags on their own line.
#}
# Generated by Bastion (https://github.com/VISHNU0906/bastion) -- DO NOT EDIT BY HAND.
# Security SLOs: multi-window multi-burn-rate (Google SRE Workbook) + threshold invariants.
groups:
  - name: {{ group_name }}
    rules:
{% for slo in slos %}
      # ====================================================================
      # SLO: {{ slo.name }} -- sli_type {{ slo.sli_type }}
{% if slo.description %}
      # {{ slo.description }}
{% endif %}
{% if slo.is_burn_rate %}
      # objective {{ slo.objective }}% over {{ slo.window }}, error budget = {{ "%.4g"|format(slo.error_budget) }}
      # ====================================================================
      # --- Recording rules: error ratio per window ---
{% for window in slo.windows %}
      - record: securityslo:{{ slo.slug }}:error_ratio_rate{{ window }}
        expr: {{ slo.error_ratio_expr(window) | yaml_quote }}
        labels:
          slo: {{ slo.slug | yaml_quote }}
          window: {{ window | yaml_quote }}
          sli_type: {{ slo.sli_type | yaml_quote }}
{% endfor %}
      # --- Burn-rate alerts ---
{% for alert in slo.alerts %}
      - alert: {{ slo.alert_name(alert) }}
        expr: {{ slo.alert_expr(alert) | yaml_quote }}
        for: {{ alert.severity == "page" and "2m" or "15m" }}
        labels:
          severity: {{ alert.severity | yaml_quote }}
          slo: {{ slo.slug | yaml_quote }}
          team: {{ "security" | yaml_quote }}
          burn_rate: {{ ("%g"|format(alert.burn_rate)) | yaml_quote }}
        annotations:
          summary: {{ ("Security SLO burn: " ~ slo.name ~ " is burning error budget " ~ ("%g"|format(alert.burn_rate)) ~ "x") | yaml_quote }}
          description: {{ ("Over the last " ~ alert.long_window ~ " (confirmed by the last " ~ alert.short_window ~ ") the error ratio for " ~ slo.name ~ " exceeded " ~ ("%.4g"|format(alert.threshold)) ~ " (= " ~ ("%g"|format(alert.burn_rate)) ~ "x the " ~ ("%.4g"|format(slo.error_budget)) ~ " budget). At this rate ~" ~ ("%g"|format(alert.budget_consumed * 100)) ~ "% of the " ~ slo.window ~ " budget burns over the long window.") | yaml_quote }}
          runbook: {{ ("Investigate the " ~ slo.name ~ " security SLO. Bastion opens an incident on breach; follow the linked runbook.") | yaml_quote }}
{% endfor %}
{% else %}
      # threshold invariant (no error budget): alerts when the limit is breached
      # ====================================================================
      - alert: {{ slo.threshold_alert_name() }}
        expr: {{ slo.threshold_expr() | yaml_quote }}
        for: {{ slo.threshold_severity == "page" and "2m" or "15m" }}
        labels:
          severity: {{ slo.threshold_severity | yaml_quote }}
          slo: {{ slo.slug | yaml_quote }}
          team: {{ "security" | yaml_quote }}
        annotations:
          summary: {{ ("Security invariant breached: " ~ slo.name) | yaml_quote }}
          description: {{ ("The hard security invariant for " ~ slo.name ~ " is breached: " ~ slo.threshold_expr() ~ ". There is no error budget for this SLO; it must be zero.") | yaml_quote }}
          runbook: {{ ("Investigate the " ~ slo.name ~ " invariant immediately. Bastion opens an incident on breach.") | yaml_quote }}
{% endif %}
{% endfor %}
